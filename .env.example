# Porta HTTP do servidor
PORT=8417
# Endereço de escuta (0.0.0.0 para acesso na rede local)
HOST=0.0.0.0
# Ambiente: production | development
NODE_ENV=production
# Segredo usado para assinar/derivar valores internos. Gere com: openssl rand -hex 32
APP_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres
# Caminho do banco SQLite
DATABASE_PATH=./storage/database/noxis.db
# Define cookies como Secure (use true atrás de HTTPS / Cloudflare Tunnel)
COOKIE_SECURE=false
# Número máximo de verificações executadas em paralelo
MAX_CONCURRENT_CHECKS=20
# Socket do Docker (opcional). Ex.: /var/run/docker.sock. Vazio desativa o monitoramento Docker.
DOCKER_SOCKET=
