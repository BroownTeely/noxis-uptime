<% const canEdit = ['owner','admin','editor'].includes(user.role); %>
<% locals.headerActions = canEdit ? '<button class="btn btn--primary" type="button" data-open-fragment="/fragments/monitor-form" data-fragment="monitor-form" data-title="Novo monitor">Novo monitor</button>' : ''; %>
<%- include('../partials/shell-start') %>
<section class="toolbar">
  <label class="search">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
    <input type="search" id="monitorSearch" placeholder="Buscar por nome, endereço ou tag" aria-label="Buscar monitores">
  </label>
  <select id="filterStatus" aria-label="Filtrar por status">
    <option value="">Todos os status</option>
    <option value="UP">Online</option><option value="DOWN">Offline</option><option value="PENDING">Pendente</option>
    <option value="DEGRADED">Degradado</option><option value="PAUSED">Pausado</option><option value="MAINTENANCE">Manutenção</option>
  </select>
  <select id="filterGroup" aria-label="Filtrar por grupo">
    <option value="">Todos os grupos</option>
    <% groups.forEach(g => { %><option value="<%= g.id %>"><%= g.name %></option><% }) %>
  </select>
  <span class="muted" id="monitorCount"><%= monitors.length %> monitores</span>
</section>

<section class="card card--flush">
  <div class="table-wrap">
    <table class="table table--monitors" id="monitorTable">
      <thead>
        <tr>
          <th>Status</th><th>Nome</th><th class="hide-md">Tipo</th><th>Endereço</th><th>Grupo</th>
          <th class="num">Latência</th><th class="num">Disp. 24h</th><th>Última verificação</th><th class="actions-col">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% monitors.forEach(m => { const st = helpers.statusMeta(m.status); const t = types.find(x => x.value === m.type); %>
        <tr data-monitor-id="<%= m.id %>" data-status="<%= m.status %>" data-group="<%= m.groupId || '' %>"
            data-search="<%= (m.name + ' ' + m.target + ' ' + (m.tags || []).join(' ')).toLowerCase() %>">
          <td data-label="Status"><span class="badge badge--<%= st.cls %>" data-field="status"><span class="badge__dot"></span><%= st.label %></span></td>
          <td data-label="Nome" class="cell-name"><a class="strong" href="/monitors/<%= m.id %>"><%= m.name %></a>
              <% if (m.tags && m.tags.length) { %><div class="tags"><% m.tags.forEach(tag => { %><span class="tag"><%= tag %></span><% }) %></div><% } %></td>
          <td data-label="Tipo" class="hide-sm hide-md nowrap"><span class="muted"><%= t ? t.label : m.type %></span></td>
          <td data-label="Endereço" class="mono truncate-sm" title="<%= m.target %>"><%= m.target %></td>
          <td data-label="Grupo" class="hide-sm"><%= m.groupName || '—' %></td>
          <td data-label="Latência" class="num mono nowrap" data-field="latency"><%= m.lastLatencyMs !== null && m.lastLatencyMs !== undefined ? m.lastLatencyMs + ' ms' : '—' %></td>
          <td data-label="Disp. 24h" class="num mono nowrap" data-field="uptime"><%= m.uptime24h !== null && m.uptime24h !== undefined ? m.uptime24h.toFixed(2) + '%' : '—' %></td>
          <td data-label="Última verificação" class="mono nowrap hide-sm" data-field="lastCheck"><%= helpers.formatDate(m.lastCheckAt, timezone, false) %></td>
          <td class="actions" data-label="Ações">
            <% if (canEdit) { %>
            <button class="icon-btn" data-action="run" title="Executar agora" aria-label="Executar agora"><svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4L21 8"/><path d="M21 3v5h-5"/></svg></button>
            <button class="icon-btn" data-action="toggle" data-active="<%= m.active %>" title="<%= m.active ? 'Pausar' : 'Retomar' %>" aria-label="<%= m.active ? 'Pausar' : 'Retomar' %>">
              <% if (m.active) { %><svg viewBox="0 0 24 24"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg><% } else { %><svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></svg><% } %>
            </button>
            <button class="icon-btn" type="button" data-open-fragment="/fragments/monitor-form?id=<%= m.id %>" data-fragment="monitor-form" data-title="Editar monitor" title="Editar" aria-label="Editar"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
            <button class="icon-btn" data-action="duplicate" title="Duplicar" aria-label="Duplicar"><svg viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></button>
            <% if (user.role === 'owner' || user.role === 'admin') { %>
            <button class="icon-btn icon-btn--danger" data-action="delete" title="Excluir" aria-label="Excluir"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
            <% } %>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% if (!monitors.length) { %>
          <tr><td colspan="9" class="empty">Nenhum monitor cadastrado</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<% locals.pageScript = 'monitors' %>
<%- include('../partials/shell-end') %>
