<% locals.headerActions = '<button class="btn btn--primary" type="button" data-open-fragment="/fragments/group-form" data-fragment="group-form" data-title="Novo grupo">Novo grupo</button>'; %>
<%- include('../partials/shell-start') %>
<% const canEdit = ['owner','admin','editor'].includes(user.role); %>
<section class="card card--flush">
  <div class="table-wrap">
    <table class="table" id="groupsTable">
      <thead><tr><th>Grupo</th><th class="num">Monitores</th><th class="num">Online</th><th class="num">Offline</th><th class="num">Pausados</th><th class="num">Disp. 24h</th><th class="actions-col"></th></tr></thead>
      <tbody>
        <% groups.forEach(g => { %>
        <tr data-group-id="<%= g.id || '' %>" data-name="<%= g.name %>">
          <td><strong><%= g.name %></strong></td>
          <td class="num"><%= g.total %></td>
          <td class="num c-up"><%= g.online %></td>
          <td class="num c-down"><%= g.offline %></td>
          <td class="num c-muted"><%= g.paused %></td>
          <td class="num mono"><%= g.availability24h !== null ? g.availability24h.toFixed(2) + '%' : '—' %></td>
          <td class="actions">
            <% if (canEdit && g.id) { %>
            <button class="icon-btn" type="button" data-open-fragment="/fragments/group-form?id=<%= g.id %>" data-fragment="group-form" data-title="Editar grupo" aria-label="Editar"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
            <% if (['owner','admin'].includes(user.role)) { %><button class="icon-btn icon-btn--danger" data-action="delete-group" aria-label="Excluir"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button><% } %>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% if (!groups.length) { %><tr><td colspan="7" class="empty">Nenhum grupo</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>
<% locals.pageScript = 'groups' %>
<%- include('../partials/shell-end') %>
