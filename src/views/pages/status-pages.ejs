<% locals.headerActions = '<button class="btn btn--primary" type="button" data-open-fragment="/fragments/status-page-form" data-fragment="status-page-form" data-title="Nova status page">Nova status page</button>'; %>
<%- include('../partials/shell-start') %>
<section class="card card--flush">
  <div class="table-wrap">
    <table class="table" id="statusPagesTable">
      <thead><tr><th>Nome</th><th>Endereço</th><th>Visibilidade</th><th class="num">Serviços</th><th>Atualizada</th><th class="actions-col"></th></tr></thead>
      <tbody>
        <% pages.forEach(p => { %>
        <tr data-page-id="<%= p.id %>">
          <td><strong><%= p.name %></strong><div class="muted"><%= p.title %></div></td>
          <td class="mono"><a href="/status/<%= p.slug %>" target="_blank" rel="noopener">/status/<%= p.slug %></a>
            <% if (p.customDomain) { %><div class="muted">domínio: <%= p.customDomain %></div><% } %></td>
          <td><span class="badge badge--<%= p.isPublic ? 'up' : 'paused' %>"><%= p.isPublic ? 'Pública' : 'Privada' %></span></td>
          <td class="num"><%= p.itemCount %></td>
          <td class="mono"><%= helpers.formatDate(p.updatedAt, timezone, false) %></td>
          <td class="actions">
            <button class="icon-btn" type="button" data-open-fragment="/fragments/status-page-form?id=<%= p.id %>" data-fragment="status-page-form" data-title="Editar status page" title="Editar" aria-label="Editar"><svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
            <button class="icon-btn icon-btn--danger" data-action="delete-page" aria-label="Excluir"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
          </td>
        </tr>
        <% }) %>
        <% if (!pages.length) { %><tr><td colspan="6" class="empty">Nenhuma status page</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>
<% locals.pageScript = 'status-pages' %>
<%- include('../partials/shell-end') %>
