<header class="topbar">
  <button class="icon-btn mobile-menu" id="mobileMenu" type="button" aria-label="Mostrar ou ocultar menu" title="Mostrar ou ocultar menu">
    <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
  <div class="topbar__title">
    <h1><%= title %></h1>
    <% if (typeof subtitle !== 'undefined' && subtitle) { %><p class="muted"><%= subtitle %></p><% } %>
  </div>
  <div class="topbar__actions">
    <div class="theme-switch" role="radiogroup" aria-label="Aparência" id="themeSwitch">
      <button type="button" role="radio" aria-checked="false" data-theme-value="light" title="Tema claro" aria-label="Tema claro">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" role="radio" aria-checked="true" data-theme-value="dark" title="Tema escuro" aria-label="Tema escuro">
        <svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button type="button" role="radio" aria-checked="false" data-theme-value="system" title="Padrão do sistema" aria-label="Padrão do sistema">
        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
      </button>
    </div>
    <%- typeof headerActions !== 'undefined' ? headerActions : '' %>
  </div>
</header>
